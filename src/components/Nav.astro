---
import Mark from './Mark.astro';
const base = import.meta.env.BASE_URL;
const items = [
  ['updates/', 'Updates'],
  ['world/', 'World'],
  ['characters/', 'Characters'],
  ['story/', 'Story'],
  ['mechanics/', 'Mechanics'],
  ['look/', 'Look'],
  ['timeline/', 'Timeline'],
  ['roadmap/', 'Roadmap'],
  ['download/', 'Download'],
];
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(base + href);
---
<header class="nav">
  <div class="wrap nav-row">
    <a class="brand" href={base} aria-label="Chimera, home">
      <Mark size={26} />
      <span>Chimera</span>
    </a>
    <nav aria-label="Site">
      <ul>
        {items.map(([href, label]) => (
          <li><a href={base + href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a></li>
        ))}
        <li class="hum-item">
          <button class="hum" type="button" aria-pressed="false" title="A low drone, three minutes, loops. Off until you press it.">
            <span class="ring" aria-hidden="true"></span><span class="hum-label">the hum</span>
          </button>
          <audio id="hum-audio" loop preload="none" transition:persist="hum">
            <source src={base + 'media/hum.opus'} type="audio/ogg; codecs=opus" />
            <source src={base + 'media/hum.mp3'} type="audio/mpeg" />
          </audio>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // The hum is off by default and only starts on a press. The audio element persists
  // across page changes (client router), so it keeps playing between pages. The button
  // is re-rendered on every page; the intent ("want") lives on the audio element, and
  // the pressed state follows the element's own play/pause events.
  const bind = () => {
    const button = document.querySelector<HTMLButtonElement>('.hum');
    const audio = document.getElementById('hum-audio') as HTMLAudioElement | null;
    if (!button || !audio) return;
    const key = 'chimera-hum';
    const show = (on: boolean) => {
      document.querySelector('.hum')?.setAttribute('aria-pressed', String(on));
      document.body.classList.toggle('humming', on);
    };
    if (!audio.dataset.bound) {
      audio.dataset.bound = '1';
      audio.addEventListener('play', () => show(true));
      audio.addEventListener('pause', () => show(false));
      let fade = 0;
      const fadeTo = (target: number, ms: number) => {
        const from = audio.volume, t0 = performance.now(), id = ++fade;
        const step = (now: number) => {
          if (id !== fade) return; // a newer fade took over
          const k = Math.min(1, (now - t0) / ms);
          audio.volume = from + (target - from) * k;
          if (k < 1) requestAnimationFrame(step); else if (target === 0 && audio.dataset.want !== 'on') audio.pause();
        };
        requestAnimationFrame(step);
      };
      const start = () => {
        audio.dataset.want = 'on';
        if (audio.paused) audio.volume = 0;
        audio.play().then(() => fadeTo(0.6, 4000)).catch(() => { audio.dataset.want = 'off'; show(false); });
        try { sessionStorage.setItem(key, 'on'); } catch {}
      };
      const stop = () => {
        audio.dataset.want = 'off';
        fadeTo(0, 1500);
        try { sessionStorage.setItem(key, 'off'); } catch {}
      };
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement | null)?.closest?.('.hum')) return;
        audio.dataset.want === 'on' ? stop() : start();
      });
      let remembered = false;
      try { remembered = sessionStorage.getItem(key) === 'on'; } catch {}
      if (remembered) {
        // Browsers only allow this after an earlier interaction on the site; if refused, stay silent.
        audio.dataset.want = 'on'; audio.volume = 0.6;
        audio.play().catch(() => { audio.dataset.want = 'off'; });
      }
    }
    show(!audio.paused);
  };
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .nav { border-bottom: var(--rule); background: var(--bg-sunk); }
  .nav-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.8rem; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--lavender); font-family: var(--font-display); font-size: 1.45rem; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 36; }
  .brand span { color: var(--fg); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.8rem, 2.4vw, 1.8rem); flex-wrap: wrap; }
  nav a { text-decoration: none; padding: 0.3rem 0; border-bottom: 1.5px solid transparent; }
  nav a:hover { border-bottom-color: var(--lavender); }
  nav a[aria-current='page'] { border-bottom-color: var(--kai); }
  .hum { display: inline-flex; align-items: center; gap: 0.45rem; background: none; border: 0; padding: 0.3rem 0; color: var(--fg-faint); font: inherit; font-size: 0.92rem; cursor: pointer; border-bottom: 1.5px solid transparent; }
  .hum:hover { color: var(--fg); }
  .hum .ring { width: 0.7em; height: 0.7em; border-radius: 50%; border: 1.5px solid currentColor; }
  .hum[aria-pressed='true'] { color: var(--fg); }
  .hum[aria-pressed='true'] .ring { background: var(--kai); border-color: var(--kai); animation: hum-pulse 6s ease-in-out infinite; }
  @keyframes hum-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .hum .ring { animation: none !important; } }
  @media (max-width: 40rem) { .nav-row { justify-content: center; } }
</style>
