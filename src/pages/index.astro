---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { kai, townsfolk } from '../data/characters';
import hero from '../assets/media/street-arrival.jpg';
import courtyardKai from '../assets/media/courtyard-kai-cape.jpg';
import lineup from '../assets/media/lineup-drawing.jpg';
import browser2025 from '../assets/media/lineage-browser-2025.jpg';
import godot2026 from '../assets/media/lineage-godot-2026.jpg';
import streetCentre from '../assets/media/street-centre.jpg';
import paintingCourtyard from '../assets/media/painting-courtyard.jpg';

const base = import.meta.env.BASE_URL;
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = updates.slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const asOf = updates[0]?.data.date;
const paint = await getImage({ src: paintingCourtyard, width: 1400, format: 'webp' });
---
<Base>
  <section class="hero">
    <div class="hero-art" data-mirror>
      <Image class="hero-img" src={hero} alt="Kai walks into the Havenwood courtyard. Five townsfolk stand around the well and the shop, each a tall figure with a round void somewhere in their clothes." widths={[800, 1200, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
      <canvas class="hero-gl" aria-hidden="true"></canvas>
      <p class="hero-hint" aria-hidden="true">move · hold</p>
    </div>
    <div class="hero-text">
      <div class="panel">
      <h1><span class="phase paint" data-text="Chimera" style={`--paint: url(${paint.src})`}>Chimera</span></h1>
      <p class="lede">A town that was painted before it was built. A boy drawn in ink who does not always stay drawn. Somewhere past the chapel, the paint stops.</p>
      <p class="asof">Anchor stabilized {asOf ? fmt(asOf) : ''}. This is the record of where the game stands. The record is kept in order.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap status">
      <div>
        <h2>Where it stands</h2>
        <p class="muted">What is anchored in the packaged build, as far as the record knows. The build is native, on a Mac, and playable from the courtyard to the estate gate. The record has been wrong before and corrected itself.</p>
      </div>
      <dl class="ledger">
        <div><dt>Engine</dt><dd>Unreal Engine 5, since 19 October 2026. Before that the same world was proved in Godot, and before that it was a browser game.</dd></div>
        <div><dt>Look</dt><dd>Locked on 20 October: ink lines, five value bands, lavender shadows, paper grain, flat painted colour, no global illumination. <a href={base + 'look/'}>How it works</a>.</dd></div>
        <div><dt>Places</dt><dd>Twelve are built, on one map with no loading: the courtyard and the street, the lane down to the harbour, the church square and the hill village, Dyers' Steps, the chapel, the shop and the Rusted Cog from the inside, a rooftop garden, and the road to the estate gate. A first patch of the opening desert lies 7.4 kilometres off. The Long Road is a separate exploration prototype, now dressed in golden grass, stone, trees and river arches. <a href={base + 'world/'}>The world</a>.</dd></div>
        <div><dt>People</dt><dd>Kai and {townsfolk.length} townsfolk, made from three lineup drawings and one of Greta alone. Each has a name and something to say. Four will trade with you. A few walk routes. <a href={base + 'characters/'}>The characters</a>.</dd></div>
        <div><dt>Story</dt><dd>A desert prologue and four acts, since 26 October. Act I is Havenwood, and Havenwood is what is built. The cast and the systems are written. <a href={base + 'story/'}>The story</a>, <a href={base + 'mechanics/'}>the mechanics</a>.</dd></div>
        <div><dt>Latest build</dt><dd>Long Road 6, 27 October 2026, macOS on Apple Silicon. Launch checks passed. The scenery and light have moved toward the paintings; Nic has not accepted this build yet. The jump and village ground changed after his earlier playtest.</dd></div>
        <div><dt>Now</dt><dd>Nic's eye on the latest Long Road and the darker Stranger. The hollow still shows its boxes. A clean performance sample for Long Road 6 remains open. <a href={base + 'roadmap/'}>The roadmap</a>.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Recent updates</h2>
        <p>Each entry is a save point. Touch one and it shows you a frame of something that already happened. <a href={base + 'updates/'}>All of them</a>.</p>
      </div>
      <ol class="update-list">
        {latest.map((u) => (
          <li>
            <a class="update" href={`${base}updates/${u.id}/`}>
              {u.data.cover && <Image src={u.data.cover} alt={u.data.coverAlt ?? ''} widths={[400, 800, 1200]} sizes="(min-width: 60rem) 33vw, 100vw" />}
              <time datetime={u.data.date.toISOString()}>{fmt(u.data.date)}</time>
              <h3>{u.data.title}</h3>
              <p>{u.data.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="moving">
        <div>
          <h2>Moving</h2>
          <p class="muted">The first recording. A camera followed a drawing around a painting for forty seconds and nobody stopped it. Courtyard, street, arch, well, two conversations. Trimmed at the ends, otherwise as it happened.</p>
          <p class="small muted">It plays on its own and loops. There is no sound in it; the sound is in the navigation.</p>
        </div>
        <figure class="frame clip">
          <video src={base + 'media/havenwood-walk-2026-10-22.mp4'} poster={base + 'media/havenwood-walk-poster.jpg'} autoplay muted loop playsinline preload="metadata" aria-label="Forty seconds of walking Havenwood in the packaged build."></video>
          <figcaption><b>Havenwood, 22 October.</b> Walk, run, talk. The camera goes through the tree once, which is on the list.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>From the build</h2>
        <p>Frames from the review rig, which takes the same views after every change so the look can be checked against the day it was accepted. The rig does not know what it is looking at.</p>
      </div>
      <div class="frames frames-2">
        <Frame src={courtyardKai} alt="Kai from behind in the courtyard, his cape blowing, the Shopkeeper and Child nearby." label="Courtyard, late afternoon." caption="Kai, the Shopkeeper and the Child under the painted sky." />
        <Frame src={streetCentre} alt="The street: a tree in a stone planter, an arched door with steps, a lantern." label="The street." caption="Laid out from the town kit on a one-metre grid." />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Where the people come from</h2>
        <p>Every figure in the game starts as this drawing. It is taken apart, turned into a shape, and the drawing is put back on as skin. The head and hands are built by hand. They do not remember any of this.</p>
      </div>
      <Frame src={lineup} alt="Lineup drawing of six figures: Kai in a navy cape, a woman in teal, a shopkeeper in yellow with a cone hat, an old man in violet with a ring head, a child in coral, a fisherman in blue." label="The lineup." caption="Masks and holes: tall faceless or masked figures, one round void each. Kai is the one in red." sizes="(min-width: 70rem) 78rem, 100vw" widths={[800, 1200, 1600, 2000]} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>How it got here</h2>
        <p>Three versions of the same square. The story stayed where it was. Everything around it was replaced, twice. The record calls this iteration. <a href={import.meta.env.BASE_URL + 'timeline/'}>The whole timeline</a> goes back to May 2025.</p>
      </div>
      <div class="frames frames-3 frames-even">
        <Frame src={browser2025} alt="Pixel-art village square with a fountain and a large tree, from the browser game." label="February 2026." caption="A browser JRPG in pixel art, with battles and quests. It is still in this repository's history." sizes="(min-width: 60rem) 33vw, 100vw" />
        <Frame src={godot2026} alt="Three-dimensional village square with half-timbered houses and a fountain, from the Godot build." label="September 2026." caption="A native 3D town in Godot. It played, but it read as toy blocks, and that led to the painted direction." sizes="(min-width: 60rem) 33vw, 100vw" />
        <Frame src={streetCentre} alt="The painted-look street from the Unreal build." label="October 2026." caption="Unreal Engine, with the look locked and the figures drawn." sizes="(min-width: 60rem) 33vw, 100vw" />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; min-height: min(88vh, 58rem); display: grid; align-items: end; }
  .hero-art { position: absolute; inset: 0; z-index: -1; cursor: crosshair; }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 65%; }
  .hero-gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 900ms ease; }
  .hero-art.live .hero-gl { opacity: 1; }
  .hero-hint { position: absolute; top: 1rem; right: var(--gutter); margin: 0; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg); opacity: 0; mix-blend-mode: difference; transition: opacity 1s ease 2s; }
  .hero-art.live .hero-hint { opacity: 0.7; }
  @media (pointer: coarse) { .hero-hint { display: none; } }
  .paint { background: var(--paint) center / cover no-repeat; -webkit-background-clip: text; background-clip: text; color: transparent; animation: pan 36s ease-in-out infinite alternate; filter: saturate(1.15) contrast(1.05); }
  @keyframes pan { from { background-position: 20% 40%; } to { background-position: 80% 60%; } }
  @media (prefers-reduced-motion: reduce) { .paint { animation: none; } }
  .hero-text { width: min(100% - 2 * var(--gutter), var(--page)); margin-inline: auto; padding-block: 0 clamp(1.5rem, 5vw, 4rem); }
  .panel { background: color-mix(in oklab, var(--bg) 94%, transparent); border: 1px solid var(--edge); box-shadow: var(--shadow); backdrop-filter: blur(6px); padding: clamp(1.4rem, 3vw, 2.4rem) clamp(1.4rem, 3vw, 2.6rem); max-width: 36rem; }
  .hero h1 { font-size: clamp(3.4rem, 8vw, 6.5rem); margin-bottom: 0.2em; color: var(--fg); }

  .lede { font-family: var(--font-display); font-variation-settings: 'SOFT' 100, 'opsz' 24; font-size: clamp(1.15rem, 1.9vw, 1.4rem); line-height: 1.3; max-width: 32ch; margin-bottom: 0.9rem; }
  .asof { max-width: 48ch; margin: 0; color: var(--fg-soft); font-size: 0.95rem; }

  .status { display: grid; gap: 2rem 4rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); align-items: start; }
  @media (max-width: 60rem) { .status { grid-template-columns: 1fr; } }

  .update-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .update-list li { max-width: none; }
  .update { display: block; text-decoration: none; }
  .update :global(img) { border: 1px solid var(--edge); box-shadow: var(--shadow); margin-bottom: 1.2rem; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .update time { display: block; font-size: 0.88rem; color: var(--fg-soft); margin-bottom: 0.3rem; }
  .update h3 { margin-bottom: 0.4rem; }
  .update:hover h3 { text-decoration: underline; text-decoration-color: var(--ochre); text-underline-offset: 0.15em; text-decoration-thickness: 1px; }
  .update p { margin: 0; color: var(--fg-soft); }
  .moving { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 2rem 4rem; align-items: start; }
  .moving h2 { margin-bottom: 1rem; }
  .clip video { width: 100%; aspect-ratio: 1600 / 896; }
  @media (max-width: 60rem) { .moving { grid-template-columns: 1fr; } }
</style>
