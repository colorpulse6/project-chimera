---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { Image } from 'astro:assets';
import { kai, townsfolk } from '../data/characters';
import composite from '../assets/media/townsfolk-today-vs-drawn.jpg';
import lineup2 from '../assets/media/lineup-2-drawing.jpg';
import strip2 from '../assets/media/townsfolk-second-lineup.jpg';
import lineup3 from '../assets/media/lineup-3-drawing.jpg';
import strip3 from '../assets/media/townsfolk-third-lineup.jpg';
import walkerFisherman from '../assets/media/walker-fisherman.jpg';
import walkerChild from '../assets/media/walker-child.jpg';
const all = [kai, ...townsfolk];
const cast = [
  ['Elara', 'Kai\u2019s sister', 'Went into the old ruins and did not come back. The one memory the execution left him. What she turns out to be decides the ending.'],
  ['Rex', 'The pragmatic scavenger', 'Patched leather with glowing conduits, goggles made from old sensors, a pneumatic tool that fires charged bolts. Calls magic broken machinery and is usually right. Found in the ruins outside Havenwood.'],
  ['Seraph', 'The awakened enforcer', 'A Corrector who saw one Nullification too many. Still wears the under-suit, has defaced the armour. Precise, formal, and bitter about it.'],
  ['Zenith', 'The glitch-witch', 'Lives where the distortions cluster. Mismatched layers covered in corrupted glyphs and blinking salvage, hair streaked by exposure. Speaks in fragments that turn out to be true.'],
  ['Valerian', 'The archivist', 'A scholar, possibly a former Keeper of the Lineage, with a satchel of forbidden texts and a decoder for old machines. Believes in verifiable truth over dogma.'],
  ['Lyra', 'The apostate', 'A Lumina whose family faked her death to save her from correction. Wears a defaced sigil and hides the Mark in her eyes. Wants to rewrite the code she was born with.'],
  ['Cog', 'The discarded construct', 'Unit 734, a precursor maintenance robot that became conscious by watching the resets. Patched from every era, one eye flickering. Asks whether your will is any different from its programming.'],
  ['Cora', 'The princess', 'Youngest of House Lumina, not glitched, cheerful, curious, and tired of the gilded walls. Her luck is The System keeping her blessed, though she does not know it.'],
  ['Kaelen Lumina', 'The reality weaver', 'A lord who understands The System as a machine and wants to become its source code. The nearest thing the story has to a villain who is not the architect.'],
  ['Aris Thorne', 'The technocrat', 'A Lumina by birth, married into an engineering house on Ferrus Magna. Rejects the mysticism and wants the technology.'],
  ['Valerius Lumina', 'The whispering glitch', 'A Glitched Scion in unstable symbiosis with a fragment of precursor AI at a Whispering Ruin. A cult has grown around him.'],
];
---
<Base title="Characters" description="Kai, who is drawn, and the townsfolk of Havenwood, who are painted and do not remark on the voids in their clothes. Then the cast still to draw.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h1>Characters</h1>
        <p>Tall figures, calm colour, a mask or no face, and one round void each. Nobody in Havenwood remarks on the voids. They were drawn as a lineup first; the game keeps the drawing’s ink and colour and most of its intentions.</p>
      </div>
      <div class="people">
        {all.map((c) => (
          <article class="person" id={c.slug}>
            <figure class="portrait">
              <Image src={c.drawing} alt={`Drawing of ${c.name}.`} widths={[300, 600, 900]} sizes="(min-width: 60rem) 16rem, 40vw" />
            </figure>
            <div class="person-text">
              <h2>{c.name}</h2>
              <p class="role">{c.role}. {c.place}.</p>
              <p class="small muted"><span class={`state state-${c.status}`}>{c.statusText}</span></p>
              {c.body.map((para) => <p>{para}</p>)}
            </div>
            <div class="person-frames">
              <Frame src={c.inGame} alt={`${c.name} in the game.`} caption="In the game." sizes="(min-width: 60rem) 28rem, 100vw" widths={[500, 900, 1400]} />
              {c.face && <Frame src={c.face} alt={`${c.name}, close.`} caption="Close." sizes="(min-width: 60rem) 28rem, 100vw" widths={[500, 900, 1400]} />}
            </div>
            {c.extra && <div class="person-extra"><Frame src={c.extra.src} alt={c.extra.caption} caption={c.extra.caption} sizes="(min-width: 70rem) 78rem, 100vw" widths={[800, 1200, 1800]} /></div>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>The second lineup</h2>
        <p>Six more, drawn on 22 October in the first lineup's hand and picked from three versions. By the evening all six were standing in the lane, the harbour and the courtyard, with names, lines and two walking routes. Rowan was meant to be a man. The drawing disagreed and was kept.</p>
      </div>
      <div class="frames frames-2">
        <Frame src={lineup2} alt="Drawing of six figures: Sal in slate blue, Rowan in a pale apron, Frida in ochre with a teal scarf, Tom in an olive coat, Anna in cream, Grandmother Edith in lavender." label="Lineup two." caption="Masks and holes again. One void each, and one crescent." sizes="(min-width: 70rem) 39rem, 100vw" />
        <Frame src={strip2} alt="The six figures in the game, side by side, in the order of the drawing." label="In the game, the same evening." caption="Sal, Rowan, Frida, Tom, Anna, Edith." sizes="(min-width: 70rem) 39rem, 100vw" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>The third lineup, and Greta</h2>
        <p>Three more for the chapel and the Rusted Cog, drawn on 25 October and accepted as drawn. In the game they first came out a little off: long dark necks, paler cloth, hair like a white cap. They were reworked against the drawing, two or three rounds each, before Nic passed them. Greta came a day earlier, on her own sheet.</p>
      </div>
      <div class="frames frames-2">
        <Frame src={lineup3} alt="Drawing of three figures: Father Silas in a red robe with a cream stole, Old Ferris in an ochre coat with a cane, the Hooded Stranger in a taupe cloak." label="Lineup three." caption="Silas, Ferris, the Stranger. The Stranger's void is the hood." sizes="(min-width: 70rem) 39rem, 100vw" />
        <Frame src={strip3} alt="The same three in the game, side by side." label="In the game, 25 October." caption="Silas in the chapel, Ferris and the Stranger in the Cog. The Stranger is being made darker." sizes="(min-width: 70rem) 39rem, 100vw" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Before and after</h2>
        <p>The left columns are the earlier procedural figures, built from primitives. The right columns are the drawn ones that replaced them on 22 October. Same places, same light.</p>
      </div>
      <Frame src={composite} alt="A sheet of five rows, one per resident, comparing the procedural figure and the drawn figure, full and close." label="Today versus drawn." caption="The review sheet that made the decision." sizes="(min-width: 70rem) 78rem, 100vw" widths={[800, 1200, 1800, 2400]} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Moving</h2>
        <p>Three loops from the first recording, 22 October. Kai walks. The townsfolk stand, or follow their routes, which are the same routes every time, which is fine.</p>
      </div>
      <div class="frames frames-3">
        <Frame src="media/loop-courtyard.mp4" poster="media/havenwood-walk-poster.jpg" alt="Kai walks across the courtyard, cape blowing, the clock tower behind." caption="The courtyard." />
        <Frame src="media/loop-street.mp4" alt="Kai walks down the street between the yellow house and the blue house." caption="The street." />
        <Frame src="media/loop-arch.mp4" alt="Kai walks under the arch and into the courtyard with the well." caption="The arch, back into the courtyard." />
      </div>
      <div class="frames frames-2 walkers">
        <Frame src={walkerFisherman} alt="The Fisherman mid-stride in the courtyard." caption="The Fisherman mid-stride, from the walk test." />
        <Frame src={walkerChild} alt="The Child walking past the shop." caption="The Child on her route past the shop." />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2><span class="state state-next">Still to draw</span></h2>
        <p>The companions and the people of the wider story, as written in 2025. None of them has a drawing yet, and a drawing is where each one really starts.</p>
      </div>
      <div class="cast">
        {cast.map(([name, role, body]) => (
          <article class="cast-card">
            <h3>{name}</h3>
            <p class="role">{role}</p>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .people { display: grid; gap: clamp(3.5rem, 7vw, 6rem); }
  .person { display: grid; grid-template-columns: 14rem minmax(0, 1fr) minmax(0, 1.4fr); gap: 1.5rem 3rem; align-items: start; padding-top: 2.5rem; border-top: var(--rule); }
  .people .person:first-child { border-top: 0; padding-top: 0; }
  .portrait { margin: 0; }
  .portrait :global(img) { width: 100%; height: auto; border: 1px solid var(--edge); box-shadow: var(--shadow); background: #faf6ee; }
  .person h2 { margin-bottom: 0.2rem; }
  .role { color: var(--fg-soft); margin-bottom: 0.4rem; }
  .person-frames { display: grid; gap: 1.6rem; min-width: 0; }
  .person-text { min-width: 0; }
  .person-extra { grid-column: 1 / -1; }
  .person-text .state { white-space: normal; align-items: flex-start; }
  .person-text .state::before { margin-top: 0.3em; }
  @media (max-width: 70rem) { .person { grid-template-columns: 12rem minmax(0, 1fr); } .person-frames { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; } }
  @media (max-width: 40rem) { .person { grid-template-columns: minmax(0, 1fr); } .portrait { max-width: 12rem; } .person-frames { grid-template-columns: minmax(0, 1fr); } }
  .walkers { margin-top: clamp(1.6rem, 3.5vw, 3rem); }
  .cast { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1.4rem; }
  .cast-card { border: 1px solid var(--line); background: var(--bg-raised); padding: 1.2rem 1.3rem 1rem; }
  .cast-card h3 { margin-bottom: 0.15rem; }
  .cast-card .role { color: var(--fg-faint); font-size: 0.88rem; margin-bottom: 0.6rem; }
  .cast-card p:last-child { margin: 0; color: var(--fg-soft); font-size: 0.95rem; }
</style>
