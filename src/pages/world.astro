---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Chart from '../components/Chart.astro';
import { Image } from 'astro:assets';
import { places } from '../data/places';
import firstMap from '../assets/media/orig-world-map.jpg';
const base = import.meta.env.BASE_URL;

// How far out it gets stranger. From the working notes of 25 October 2026 (Nic's seeds and
// assistant proposals, saved, not all selected): outside Havenwood the regions are not climates,
// they are deeper shortcuts in how the world is kept. Marked by what exists of each.
const depth = [
  { n: '0', name: 'Havenwood', rule: 'The pleasant facade.', text: 'A bright town built to calm one anomaly: simple errands, friendly people, a chapel on the headland, and small things that are wrong. Nobody patrols. You are told the gods restrict the road.', state: 'built', stateText: 'Built, in the public demo', href: '#havenwood' },
  { n: '1', name: 'The settlement that expected him', rule: 'Identity written in advance.', text: 'In the concept, just outside the valley; in the build, half a kilometre from the square. A place that has prepared for Kai for generations: an empty bedroom kept, clothes cut to his measure, and household instructions that contradict each other. Havenwood tried to erase him. This place tries to write him.', state: 'now', stateText: 'Keepers’ Cove, internal build, with stand-ins', href: '#cove-settlement' },
  { n: '2', name: 'The city that forgets every morning', rule: 'Memory as a ledger someone else keeps.', text: 'At dawn a chime takes yesterday and leaves language and craft. Every house has a morning table: who you are, whom you love, what you owe. The wealthy pay to have their memories certified. Someone edits the tables overnight. Kai, who does not reset, is asked to carry what people are afraid to write down.', state: 'next', stateText: 'Aethelburg, written, rules undesigned', href: 'ideas/#forgets' },
  { n: '3', name: 'The city whose rooms migrate', rule: 'Space as a stage set.', text: 'The streets stay still. The rooms beneath them travel on tracks and counterweights through a huge internal structure: a house has its kitchen every third day, the public bath arrives under the square at noon. A door Kai passed earlier opens later on a room from his past.', state: 'next', stateText: 'An idea, saved', href: 'ideas/#migrate' },
  { n: '4', name: 'The town that takes turns sleeping', rule: 'To be is to be perceived.', text: 'A street that nobody conscious is watching is unloaded. Watchkeepers, night bakers and musicians work overlapping shifts at bedroom observation windows to keep their streets present. Children know the names of the people keeping their street there until morning.', state: 'next', stateText: 'An idea, saved', href: 'ideas/#sleeping' },
  { n: '5', name: 'The desert, again', rule: 'The beginning, and a late chapter.', text: 'The place where Kai first fell. The opening of the game, and also a late chapter, by a route that is still to be designed. What is under the sand answers to him, and the record does not say why.', state: 'now', stateText: 'First slice built; the pulse, the voice and the rising are not', href: '#opening-desert' },
] as const;

const groups = [
  ['built', 'Anchored', 'Walkable in the packaged build. As real as anything here gets.'],
  ['now', 'Weaving', 'On the same map as the courtyard; the kit is growing to fit them.'],
  ['next', 'Unwritten, but painted', 'They exist as paintings and wait for the kit.'],
] as const;

const continents = [
  ['Aethelgard', 'Temperate forests and plains, feudal kingdoms, a church that reads the machine’s interventions as providence. The Spine of the Ancients runs through it. Aethelburg, the Lumina capital, sits at its centre. Havenwood is here.'],
  ['Ferrus Magna', 'Scarred by precursor wars and industrial collapse. Scavenger clans, rust, unstable power. Neo-Veridia is a cyberpunk city built inside a dead factory; Rustwater Fishery catches metal-shelled crabs from coolant-stained water.'],
  ['Sylvandell', 'Jungle that has eaten the ruins. Magic here is biological, a way of talking to a terraforming network nobody remembers building. Krystallos is grown around a crystal lattice; Whisperwind Hermitage hangs in the glowing canopy.'],
  ['The Shifting Wastes', 'Where The System’s grip is weak and reality is unreliable. Zephyr is a city that moves, a fleet of repurposed precursor vehicles that never stops.'],
];
const factions = [
  ['The Lumina Orthodoxy', 'House Lumina, the Keepers of the Lineage and the Silent Guard. Order above all, because order is what The System wants.'],
  ['The Reality Weavers', 'Lord Kaelen Lumina and those who want to merge with the machine rather than serve it.'],
  ['The Thorne Technocracy', 'Duchess Aris Thorne’s engineers on Ferrus Magna, who want the technology without the religion.'],
  ['The Cult of the Whispering Glitch', 'Followers of Valerius, for whom the glitch is revelation.'],
  ['The Sylvan Concord', 'The guardians of Krystallos, in what they believe is harmony with living magic.'],
  ['The Unchained', 'Heretics, Glitched Scions and survivors of correction. Not a house, a network. The ones Kai is most likely to end up among.'],
];
const changes = [
  ['The opening desert', 'The game now begins here, with Kai walking until he falls. It is also a late chapter. Whether it is the Shifting Wastes is deliberately not decided.'],
  ['Kesler Pi', 'Nic named the larger desert city on 5 November. Its selected form is a dark, patched mass buried in sand, with no visible wheels, treads, legs or wake. Checkpoint 2 adds buried spurs and a near hull wall to the static skyline. The opening blocks passage; its artwork is unfinished and Nic’s acceptance is on hold. No playable interior or city motion is claimed.'],
  ['Aethelburg', 'Kept as the Lumina capital, and now the city that forgets every morning. Its rules are still to be designed.'],
  ['Zephyr', 'The smaller mobile refuge convoy, distinct from Kesler Pi. Nic kept both in the desert chapter on 5 November. Zephyr is outside the current build scope.'],
  ['The estate', 'Kai reaches its gate in Act I and finds it shut. Full access comes late.'],
];
---
<Base title="World" description="A chart of the world as the build knows it, drawn from the game’s own provisional positions; how far out it gets stranger; and every place in Havenwood, one tile each, with its full record a click away.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h1>The world</h1>
        <p>There is no finished map. There is the build, which keeps a number for where everything stands, and there are the paintings, which are right. This chart is the numbers. The paintings are a click away.</p>
      </div>
      <Chart />
    </div>
  </section>

  <section class="section">
    <div class="wrap maps">
      <div class="maps-text">
        <h2>Three maps were drawn. None is the geography.</h2>
        <dl class="ledger">
          <div><dt>27 May 2025</dt><dd>The first map, painted before there was a game: four continents, sea creatures, labels that do not quite spell. Kept as it was, on <a href={base + 'timeline/'}>the timeline</a>. Its continents survive as names.</dd></div>
          <div><dt>19 October 2026</dt><dd>A study of Havenwood and the near coast: a south-facing bay, ruins inland to the north-west, a marsh on the eastern shore, a beacon on an island. A proposal, and the build went another way: past the first kilometre, the town’s own ground is sea.</dd></div>
          <div><dt>25 October 2026</dt><dd>A world map in the manner of the first one, with roads. Nic set it aside as too generic, and asked for stranger places instead. The stranger places are below.</dd></div>
          <div><dt>Now</dt><dd>The chart above is drawn from the pins the build places its far silhouettes by. Nic moves a pin by editing a file. The map will exist when the regions do; until then the record charts what is there.</dd></div>
        </dl>
      </div>
      <figure class="frame maps-first">
        <Image src={firstMap} alt="A painted fantasy map of island continents: the Shifting Wastes, Aethelgard, Ferrus Magna, Sylvandell, with sea creatures in the water." widths={[400, 700, 1000]} sizes="(min-width: 60rem) 22rem, 100vw" />
        <figcaption>The first map. Aethelgard three times, Ferrus Magna three times.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section depth-section">
    <div class="wrap">
      <div class="section-head">
        <h2>The further out, the stranger the rule</h2>
        <p>Outside Havenwood the regions are not climates. Each one is a deeper shortcut in how the world is kept, and each asks something of the people who live in it. From the working notes of 25 October; saved, not all chosen.</p>
      </div>
      <ol class="depth">
        {depth.map((d, i) => (
          <li class="depth-row" style={`--d: ${i / (depth.length - 1)}`}>
            <span class="depth-n" aria-hidden="true">{d.n}</span>
            <div class="depth-body">
              <h3><span class="depth-name">{d.name}</span> <span class="depth-rule">{d.rule}</span></h3>
              <p>{d.text}</p>
              <p class="small"><a class={`state state-${d.state}`} href={d.href.startsWith('#') ? d.href : base + d.href}>{d.stateText}</a></p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="havenwood">
    <div class="wrap">
      <div class="section-head">
        <h2>Havenwood, place by place</h2>
        <p>A hill town between a harbour and a chapel on the headland. Each place was painted before it was built, and the build is checked against the painting. Open a tile for its record: what it is, what has been checked, and the frames.</p>
      </div>
      {groups.map(([status, title, note]) => {
        const group = places.filter((p) => p.status === status);
        if (!group.length) return null;
        return (
          <div class="tile-group">
            <h3><span class={`state state-${status}`}>{title}</span> <span class="muted tile-note">{note}</span></h3>
            <div class="tiles">
              {group.map((p) => (
                <a class="tile" id={p.slug} href={`#${p.slug}`} data-dialog={`place-${p.slug}`}>
                  <Image src={p.image} alt={p.imageAlt} widths={[400, 700]} sizes="(min-width: 60rem) 16rem, 45vw" />
                  <span class="tile-name">{p.name}</span>
                  <span class="tile-state small muted">{p.statusText}</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  {places.map((p) => (
    <dialog class="record" id={`place-${p.slug}`} aria-labelledby={`place-${p.slug}-title`}>
      <form method="dialog" class="record-bar"><span class="record-kicker"><span class={`state state-${p.status}`}>{p.statusText}</span></span><button class="record-close" aria-label="Close">×</button></form>
      <div class="record-body">
        <figure class="frame"><Image src={p.image} alt={p.imageAlt} widths={[600, 1000, 1600]} sizes="(min-width: 60rem) 56rem, 100vw" /></figure>
        <h2 id={`place-${p.slug}-title`}>{p.name}</h2>
        <p class="record-lede">{p.body}</p>
        <p class="small muted">{p.development.status}</p>
        {p.development.notes.map((note) => <p class="small">{note}</p>)}
        {p.frames && (
          <div class="frames frames-3">
            {p.frames.map((f) => <Frame src={f.src} alt={f.alt} caption={f.caption} sizes="(min-width: 60rem) 18rem, 100vw" widths={[400, 800]} />)}
          </div>
        )}
      </div>
    </dialog>
  ))}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2><span class="state state-next">Written, not painted</span></h2>
        <p>The continents and factions as written in 2025, before the painted look. A place is not real here until it is painted.</p>
      </div>
      <details class="development">
        <summary>The wider world of 2025, and what changed in October</summary>
        <div class="world-notes">
          <div>
            <h3>Continents</h3>
            <dl class="ledger">{continents.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          </div>
          <div>
            <h3>Factions</h3>
            <dl class="ledger">{factions.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <h3 class="changed">Changed in October and November</h3>
            <dl class="ledger">{changes.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <p class="small muted">Stonehearth Post, in the foothills of the Spine, is a devout village warmed by a hearth that never cools because a precursor plant runs under it, and its Keeper of the Flame is an agent of The System in a robe. That is the pattern for every place: a plain surface, a machine underneath, and someone keeping it quiet.</p>
          </div>
        </div>
      </details>
    </div>
  </section>
</Base>

<script>
  import '../scripts/records';
</script>

<style>
  .maps { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 22rem); gap: clamp(1.6rem, 4vw, 4rem); align-items: start; }
  .maps h2 { max-width: 20ch; }
  .maps-first { max-width: 22rem; }
  @media (max-width: 55rem) { .maps { grid-template-columns: 1fr; } }

  .depth { list-style: none; margin: 0; padding: 0; counter-reset: depth; }
  .depth-row { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 0 1.5rem; padding: 1.6rem 0; border-top: var(--rule); color: color-mix(in oklab, var(--fg) calc(100% - var(--d) * 40%), var(--fg-faint)); }
  .depth-row:last-child { border-bottom: var(--rule); }
  .depth-n { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.8rem; letter-spacing: 0.2em; color: var(--fg-faint); padding-top: 0.5rem; }
  .depth-n::before { content: 'LVL '; }
  .depth-body h3 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin-bottom: 0.5rem; }
  .depth-name { color: transparent; background: linear-gradient(90deg, var(--fg) calc(100% - var(--d) * 100%), transparent); -webkit-background-clip: text; background-clip: text; -webkit-text-stroke: 0.6px var(--fg); }
  .depth-rule { display: block; font-size: 1rem; font-family: var(--font-body); color: var(--lavender); margin-top: 0.2rem; }
  .depth-body p { max-width: 66ch; }
  .depth-body a.state { text-decoration: none; color: var(--fg-soft); }
  .depth-body a.state:hover { color: var(--fg); }
  @media (max-width: 40rem) { .depth-row { grid-template-columns: 1fr; } }

  .tile-group { margin-top: 2rem; }
  .tile-group h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin-bottom: 1rem; }
  .tile-note { font-family: var(--font-body); font-size: 0.9rem; font-weight: 400; }

  .world-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 4rem; align-items: start; }
  .world-notes h3 { margin-bottom: 1rem; }
  .world-notes h3.changed { margin-top: 2.5rem; }
  .world-notes .ledger > div { grid-template-columns: minmax(7rem, 10rem) 1fr; }
  .world-notes .ledger dd { font-size: 0.95rem; color: var(--fg-soft); }
  .development { border-top: var(--rule); padding-top: 0.8rem; }
  .development summary { cursor: pointer; color: var(--fg-soft); }
  .development summary::marker { color: var(--lavender); }
  .development summary:hover { color: var(--fg); }
  .development[open] > summary { margin-bottom: 1.5rem; color: var(--fg); }
  @media (max-width: 60rem) { .world-notes { grid-template-columns: 1fr; } }
  @media (max-width: 38rem) { .world-notes .ledger > div { grid-template-columns: 1fr; gap: 0.35rem; } }
</style>
