---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="You can’t go there" description="The gods restrict it.">
  <section class="section">
    <div class="narrow prose lost">
      <p class="code">Subject not found. Anchor not stabilized.</p>
      <h1>You can’t go there.</h1>
      <p class="lede">The gods restrict it. Or the record has no page by that name yet, which in Havenwood comes to the same thing.</p>
      <p><a class="button" href={base}>Back to the courtyard</a></p>
    </div>
  </section>
</Base>
<style>
  .lost { min-height: 50vh; }
  .code { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-faint); margin-bottom: 1.5rem; }
  .lede { font-family: var(--font-display); font-variation-settings: 'SOFT' 100, 'opsz' 24; font-size: clamp(1.25rem, 2vw, 1.5rem); line-height: 1.35; max-width: 36ch; margin-bottom: 2rem; }
</style>
