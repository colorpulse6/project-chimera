---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const updates = await getCollection('updates');
  return updates.map((u) => ({ params: { id: u.id }, props: { entry: u } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const all = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const i = all.findIndex((u) => u.id === entry.id);
const newer = all[i - 1];
const older = all[i + 1];
---
<Base title={entry.data.title} description={entry.data.summary} ogImage={entry.data.cover ? undefined : undefined}>
  <article class="section">
    <div class="narrow">
      <p class="crumb"><a href={base + 'updates/'}>Updates</a></p>
      <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      {entry.data.cover && (
        <figure class="frame cover">
          <Image src={entry.data.cover} alt={entry.data.coverAlt ?? ''} widths={[600, 1000, 1600]} sizes="(min-width: 60rem) 52rem, 100vw" loading="eager" />
          {entry.data.coverAlt && <figcaption>{entry.data.coverAlt}</figcaption>}
        </figure>
      )}
      <div class="prose">
        <Content />
      </div>
      <nav class="pager" aria-label="Other updates">
        {older ? <a href={`${base}updates/${older.id}/`}>Earlier: {older.data.title}</a> : <span />}
        {newer ? <a href={`${base}updates/${newer.id}/`}>Later: {newer.data.title}</a> : <span />}
      </nav>
    </div>
  </article>
</Base>
<style>
  .crumb { margin-bottom: 2rem; font-size: 0.92rem; }
  time { display: block; color: var(--fg-soft); margin-bottom: 0.6rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); }
  .summary { font-family: var(--font-display); font-variation-settings: 'SOFT' 100, 'opsz' 24; font-size: 1.3rem; line-height: 1.35; color: var(--fg-soft); max-width: 40ch; margin-bottom: 2.2rem; }
  .cover { margin-bottom: 2.5rem; }
  .pager { display: flex; justify-content: space-between; gap: 2rem; margin-top: 4rem; padding-top: 1.5rem; border-top: var(--rule); font-size: 0.95rem; }
  .pager a:last-child { text-align: right; }
</style>
